# V2 runtime
NODE_ENV=development
PORT=8787
CARESUPPORT_DISABLE_LIVE=1
CARESUPPORT_LIVE_MAX_CASES=20

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_MAX_TOKENS=450
CARESUPPORT_AGENT_SDK_TIMEOUT_MS=30000
CARESUPPORT_AI_BACKEND=anthropic
PROMPT_FAMILY_MAX_CHARS=2200
PROMPT_CONVERSATION_MAX_CHARS=1200
PROMPT_MEMBER_MAX_CHARS=700

# Optional OpenRouter fallback when Anthropic credits/rate limits fail
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Optional: Codex isolated API keys
# Use these when you want Codex test runs billed to a separate key.
CODEX_OPENROUTER_API_KEY=
CODEX_ANTHROPIC_API_KEY=
CODEX_OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Convex
CONVEX_URL=
CONVEX_DEPLOYMENT=

# Linq
LINQ_API_TOKEN=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_PHONE=
LINQ_WEBHOOK_SECRET=

# Replay/import
SNAPSHOT_OUT=./fixtures/snapshot.ndjson
SNAPSHOT_CHECKSUM=./fixtures/snapshot-checksums.json

# Optional for webhook cutover helpers
V1_WEBHOOK_TARGET_URL=
V2_WEBHOOK_TARGET_URL=
ROLLBACK_WEBHOOK_TO_V1_CMD=
ROLLFORWARD_WEBHOOK_TO_V2_CMD=
